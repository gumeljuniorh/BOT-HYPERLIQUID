# Hyperliquid Bot Configuration
# Use the AI Studio Settings menu to set these secrets

# The private key for your Hyperliquid account (Keep this secure!)
HYPERLIQUID_PRIVATE_KEY=

# Your wallet address and signer address
HYPERLIQUID_WALLET_ADDRESS=0x2807Ea3275EF4f865DFea59e18eDBA5B812C0079
HYPERLIQUID_API_WALLET=0xdaae5d2bffa4b090db68950c1d5f3245cb786711

# Set to "false" to enable live trading. Default is "true" (paper trading).
DRY_RUN=true

# Trade selection guardrails. Higher values trade less often but avoid marginal setups.
MIN_SIGNAL_CONFIDENCE=70
MIN_TRADE_QUALITY_SCORE=55
MIN_EXPECTED_MOVE_PCT=0.45
MAX_FEE_TO_EXPECTED_REWARD_RATIO=0.45
MAX_OPEN_POSITIONS=3

# API Endpoints
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
